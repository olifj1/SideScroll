{
  "schema": "sidescroll.storage-catalogue.v1",
  "about": "Every browser-storage key SideScroll uses, with what it is. The single source for what is published game content, what stays on the author's device, and what is play progress. Read by tools/bake_project.py (and, later, the Publish Lab and exports). Add a line here whenever code introduces a new key.",
  "scopes": {
    "content": "Authored game content. Published: built into the game for every player.",
    "migration": "One-off upgrade 'done' flag. Published with the content it describes, so upgrades do not re-run on already-upgraded data.",
    "local": "The author's own settings and editor view preferences. Never published.",
    "progress": "Play-through progress. Never published; every player keeps their own.",
    "transient": "Short-lived working state (recovery, pending moves, launch hand-offs). Never published or exported.",
    "backup": "Safety copy kept on the device. Never published.",
    "stale": "Not read by any current code. Never published; safe to ignore in exports."
  },
  "renamed": {
    "sidescroll.animlab.fox.clips.v1": "sidescroll.animlab.quadruped.clips.v1",
